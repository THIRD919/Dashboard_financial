# Active dashboard provider. Phase 4A keeps prototype as the safe default.
DASHBOARD_DATA_PROVIDER=prototype
APP_ENV=development
APP_URL=http://localhost:3000
STAGING_APP_URL=https://staging.example.invalid

# Local PostgreSQL only. Never commit a real password or hosted service key.
DATABASE_URL=postgresql://vet_cmu:change_me@localhost:5432/vet_cmu_financial

# Optional local Supabase values for later adapters; leave blank unless using local CLI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local authenticated UAT only. Never enable Demo Auth in production.
ENABLE_DEMO_AUTH=false
DEMO_AUTH_PASSWORD=
DEMO_SESSION_SECRET=
